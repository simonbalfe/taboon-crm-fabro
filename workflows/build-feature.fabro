digraph BuildFeature {
    graph [goal="Plan, implement, review, and verify one CRM change"]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    plan [label="Plan", prompt="Read the repository and requested goal. Produce the smallest complete implementation plan. Do not edit files."]
    approve [shape=hexagon, label="Approve plan"]
    implement [label="Implement", prompt="Implement the approved plan. Reuse existing code and keep the diff small."]
    review [label="Review", prompt="Review the implementation for correctness, security, and needless complexity. Fix only concrete issues."]
    verify [label="Verify", shape=parallelogram, script="./scripts/check", goal_gate=true, max_retries=0]
    fix [label="Fix", prompt="Read the verification output and fix the root cause. Do not weaken checks.", max_visits=3]

    start -> plan -> approve
    approve -> implement [label="[A] Approve"]
    approve -> plan [label="[R] Revise"]
    implement -> review -> verify
    verify -> exit [condition="outcome=succeeded"]
    verify -> fix
    fix -> verify
}
