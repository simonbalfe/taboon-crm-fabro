[Unit]
Description=Taboon CRM PocketBase
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=taboon-crm
Group=taboon-crm
WorkingDirectory=/opt/taboon-crm
EnvironmentFile=/etc/taboon-crm.env
ExecStart=/opt/taboon-crm/pocketbase serve --http=127.0.0.1:8090
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taboon-crm/pb_data

[Install]
WantedBy=multi-user.target
